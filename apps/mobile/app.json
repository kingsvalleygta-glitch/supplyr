{
  "expo": {
    "name": "Supplyr",
    "slug": "supplyr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "supplyr",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.kingsvalleyhomes.supplyr",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Supplyr uses your location only to show live delivery tracking on the map."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111113",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "ca.kingsvalleyhomes.supplyr",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#111113"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://supplyr-two.vercel.app",
      "eas": {
        "projectId": "supplyr-mobile"
      }
    }
  }
}
